  "narration": [
    {
      "id": "s8_01",
      "text": "Machine learning can sound mysterious at first.",
      "emphasis": "mysterious"
    },
    {
      "id": "s8_02",
      "text": "But once you look closely, it is not magic. It is mathematics, data, and structured learning working together.",
      "emphasis": "not magic"
    },
    {
      "id": "s8_03",
      "text": "We are moving from a world where we tell computers exactly what to do, to a world where we teach them how to learn from examples.",
      "emphasis": "teach them how to learn"
    },
    {
      "id": "s8_04",
      "text": "That shift is important. It changes how we build software. It changes how we think about intelligence. And it changes what kinds of problems we can solve.",
      "emphasis": "it changes"
    },
    {
      "id": "s8_05",
      "text": "That is where the real journey begins.",
      "emphasis": "begins"
    }
  ],
