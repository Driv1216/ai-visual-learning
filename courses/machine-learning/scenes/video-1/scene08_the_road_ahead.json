{
  "scene_id": "scene08_the_road_ahead",
  "video_title": "What Is Machine Learning?",
  "scene_title": "The Road Ahead",
  "order": 8,
  "duration_mode": "audio_driven",
  "voice": {
    "language": "en-IN",
    "speaker": "priya",
