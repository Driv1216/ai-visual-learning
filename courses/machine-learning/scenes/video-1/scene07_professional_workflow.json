{
  "scene_id": "scene07_professional_workflow",
  "video_title": "What Is Machine Learning?",
  "scene_title": "The Professional Workflow",
  "order": 7,
  "duration_mode": "audio_driven",
  "voice": {
    "language": "en-IN",
    "speaker": "priya",
